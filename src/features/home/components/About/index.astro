---
import { Image } from 'astro:assets';
import selfie from '../../assets/selfie.jpg';
---

<section id='about'>
  <h2 class='section-title'>
    <a href='#about'>About</a>
  </h2>
  <div class='info'>
    <figure class='person'>
      <Image
        src={selfie}
        alt='Selfie of Julian Krzysiak at Olympic National Park'
        width={300}
        height={300}
      />
      <figcaption>
        <span class='caption'>Julian Krzysiak</span>
        <span class='sub-caption'>Full-Stack Web Developer</span>
      </figcaption>
    </figure>
    <div class='words'>
      <p>
        I am a full-stack web developer who likes to hike, dance, and learn everything about
        California natural history.
      </p>
      <p>I like making websites that are clean, optimized, and accessible.</p>
      <p>I work mostly in React and dabble in Svelte. Astro is cool for static sites.</p>
    </div>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: 2rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 2rem;
    justify-content: center;
    align-items: center;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    width: 100%;

    img {
      border-radius: 50%;
      border: 1px solid var(--color-slate-900);
    }
  }

  figcaption {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .caption {
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-primary);
  }

  .sub-caption {
    font-size: var(--text-xl);
  }

  .words {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    font-size: var(--text-lg);
    line-height: 1.5rem;
  }

  p {
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    a {
      font-size: var(--text-5xl);
    }

    .info {
      flex-direction: row;
      gap: 5rem;
    }

    .caption {
      font-size: var(--text-3xl);
    }

    .sub-caption {
      font-size: var(--text-xl);
    }

    .words {
      font-size: var(--text-lg);
    }
  }
</style>
